# Copy to .env for backend development. Never commit real values.
DEBUG=False
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=stock_analyzer
MYSQL_PASSWORD=
MYSQL_DATABASE=stock_analyzer
STOCK_ANALYSIS_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
STOCK_ANALYSIS_MODEL=deepseek-v4-flash
STOCK_ANALYSIS_API_KEY=
STOCK_MCP_API_KEY=
# Merged stock/sector queries need a longer read budget than lightweight tools.
STOCK_SECTOR_MCP_READ_TIMEOUT_SECONDS=30
STOCK_SECTOR_MCP_RETRY_COUNT=1
STOCK_SECTOR_MCP_TOTAL_TIMEOUT_SECONDS=45
STOCK_SECTOR_TOTAL_TIMEOUT_SECONDS=85
LOCAL_MODEL_PATH=
LOCAL_MODEL_CACHE=./cache/models
LOCAL_MODEL_MAX_NEW_TOKENS=512
LOCAL_MODEL_PORT=8001
KSUSER_AUTH_BASE=https://auth.ksuser.cn
KSUSER_API_BASE=https://api.ksuser.cn
KSUSER_CLIENT_ID=
KSUSER_CLIENT_SECRET=
# Must match the registered OAuth callback for the environment.
KSUSER_REDIRECT_URI=https://www.muyewhisper.cn/auth/callback
KSUSER_SCOPE=profile email
