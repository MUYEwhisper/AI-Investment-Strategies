{
  "name": "ai-investment-strategies",
  "productName": "智能投资平台",
  "version": "1.0.5",
  "description": "智能投资平台 Windows 桌面客户端与前后端源码",
  "author": "MUYEwhisper",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:test": "node --test desktop/tests/*.test.cjs",
    "desktop:smoke": "node scripts/desktop-smoke.cjs",
    "desktop:pack": "electron-builder --win --x64 --dir",
    "desktop:build": "electron-builder --win nsis --x64",
    "frontend:install": "npm ci --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:test": "npm run test:unit --prefix frontend -- --run",
    "verify:baseline": "node scripts/verify-baseline.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "cn.muyewhisper.investment",
    "productName": "智能投资平台",
    "artifactName": "AI-Investment-Strategies-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/navigation.cjs",
      "desktop/desktop-shell.css",
      "desktop/window-state.cjs",
      "desktop/offline.html",
      "desktop/assets/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智能投资平台",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  }
}
